# Copy this file to .env.local and fill in real values as they become
# available. The site builds and runs fine with these left blank —
# the contact form and newsletter signup will just show a clear
# "not configured yet" message until these are set.

# Where contact-form submissions are sent
CONTACT_EMAIL=

# Resend API key — used by both the contact form and the newsletter
# signup. Get one at https://resend.com
RESEND_API_KEY=

# Resend Audience ID to add newsletter subscribers to
NEWSLETTER_AUDIENCE_ID=

# Trust's registered location, for the Contact page map embed.
# Leave blank to show a "Location map coming soon" placeholder instead.
MAP_LATITUDE=
MAP_LONGITUDE=
